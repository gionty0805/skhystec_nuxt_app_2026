datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int      @id @default(autoincrement())
  username          String   @unique // 사번 또는 SSO sub
  password          String? // 우회 로그인용 해시 비밀번호
  name              String
  email             String?
  role              String   @default("USER")
  localLoginEnabled Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model UserLog {
  id           Int      @id @default(autoincrement())
  timestamp    DateTime @default(now())
  method       String
  path         String
  userId       String
  statusCode   Int
  duration     Int
  status       String
  loginType    String? // SSO / LOCAL
  errorMessage String?
}
