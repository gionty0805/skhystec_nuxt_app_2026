datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  role      String   @default("USER")
  createdAt DateTime @default(now())
}

model UserLog {
  id           Int      @id @default(autoincrement())
  timestamp    DateTime @default(now())
  method       String
  path         String
  userId       String
  statusCode   Int
  duration     Int
  status       String
  errorMessage String?
}